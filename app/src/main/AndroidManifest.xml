<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Networking: UDP discovery + TCP transfer -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Android 13+ (and the Android 16 Local Network Protection opt-in some OEMs/builds are
         already enforcing): apps that talk to other devices on the LAN need this runtime
         permission or their broadcast/UDP sockets get silently rejected (EPERM) instead of
         discovering anything. neverForLocation is honest here - this app never derives
         physical location from Wi-Fi, it only sends/receives LAN discovery packets. -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <!-- Pre-Android 13 fallback only (NEARBY_WIFI_DEVICES above covers 13+): some OEM Wi-Fi
         stacks on API 26-32 gate broadcast/multicast delivery behind a location grant even for
         plain socket use, not just the official Wi-Fi scan APIs. maxSdkVersion means neither of
         these do anything at all on the Android 16 device this was reported on - they're purely
         for older phones. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="32" />

    <!-- Keeps the discovery/receive socket alive while the app is backgrounded -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Incoming-transfer / transfer-complete notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".CipherShareApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.CipherShare"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.CipherShare">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.CipherShareService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".service.TransferResponseReceiver"
            android:exported="false" />

        <!-- Lets History's "open file" action hand a received file to another app (viewer,
             gallery, etc.) as a content:// URI when it was saved to the app's own default
             folder rather than a user-chosen SAF folder. See util/FileOpenUtils.kt. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
